#!/bin/bash

#=============================================================================
# Trivia Quiz Game - CLI/GUI Hybrid
# Author: UzairDeveloper223
# Version: 2.0
#=============================================================================

set -euo pipefail

# Configuration
readonly DATA_DIR="./Quiz-data"
readonly DATA_FILE="$DATA_DIR/data.txt"
readonly VERSION="2"
readonly LATEST_VERSION_URL="https://raw.githubusercontent.com/uzairdeveloper223/trivia-with-zenity/Master/version.txt"
readonly TOTAL_QUESTIONS=25

# Colors for CLI mode
readonly RED='\033[0;31m'
readonly GREEN='\033[0;32m'
readonly YELLOW='\033[1;33m'
readonly BLUE='\033[0;34m'
readonly CYAN='\033[0;36m'
readonly BOLD='\033[1m'
readonly NC='\033[0m' # No Color

# Global variables
score=0
current_question=0
correct_answers=0
wrong_answers=0
MODE=""

#=============================================================================
# Utility Functions
#=============================================================================

print_color() {
    local color="$1"
    local message="$2"
    echo -e "${color}${message}${NC}"
}

print_banner() {
    clear
    print_color "$CYAN" "╔════════════════════════════════════════════╗"
    print_color "$CYAN" "║     🎯 TRIVIA QUIZ GAME v${VERSION}        ║"
    print_color "$CYAN" "╚════════════════════════════════════════════╝"
    echo
}

check_display() {
    if [[ -n "${DISPLAY:-}" ]] && command -v zenity &> /dev/null; then
        return 0
    else
        return 1
    fi
}

detect_mode() {
    if [[ "${1:-}" == "--cli" ]]; then
        MODE="cli"
    elif [[ "${1:-}" == "--gui" ]]; then
        if check_display; then
            MODE="gui"
        else
            print_color "$RED" "❌ GUI mode not available. Zenity not installed or no DISPLAY set."
            print_color "$YELLOW" "Falling back to CLI mode..."
            sleep 2
            MODE="cli"
        fi
    else
        # Auto-detect mode
        if check_display; then
            MODE="gui"
        else
            MODE="cli"
        fi
    fi
}

install_zenity() {
    if [[ "$MODE" == "gui" ]] && ! command -v zenity &> /dev/null; then
        print_color "$YELLOW" "Zenity not installed. Installing..."
        if command -v apt-get &> /dev/null; then
            sudo apt-get update && sudo apt-get install zenity -y
        elif command -v pkg &> /dev/null; then
            pkg install zenity -y
        else
            print_color "$RED" "❌ Cannot install Zenity. Switching to CLI mode."
            MODE="cli"
        fi
    fi
}

#=============================================================================
# Update Functions
#=============================================================================

check_updates() {
    local latest_version
    
    if ! latest_version=$(curl -s "$LATEST_VERSION_URL" 2>/dev/null); then
        return 1
    fi
    
    if [[ -z "$latest_version" ]] || [[ -z "$VERSION" ]]; then
        return 1
    fi
    
    if [[ "$VERSION" -lt "$latest_version" ]]; then
        return 0
    else
        return 1
    fi
}

perform_update() {
    if [[ "$MODE" == "gui" ]]; then
        zenity --info --text="🔄 Updating the quiz..." --width=300 --height=100 --timeout=2
    else
        print_color "$CYAN" "🔄 Updating the quiz..."
    fi
    
    rm -f quiz
    curl -o quiz "$LATEST_VERSION_URL" 2>/dev/null || {
        [[ "$MODE" == "gui" ]] && zenity --error --text="❌ Update failed!" --width=300 --height=100 || print_color "$RED" "❌ Update failed!"
        return 1
    }
    
    chmod +x quiz
    
    if [[ "$MODE" == "gui" ]]; then
        zenity --info --text="✅ Update complete! Restart to use new version." --width=300 --height=100 --timeout=3
    else
        print_color "$GREEN" "✅ Update complete! Run 'bash quiz' to start."
    fi
    
    exit 0
}

prompt_update() {
    local latest_version
    latest_version=$(curl -s "$LATEST_VERSION_URL" 2>/dev/null)
    
    if [[ "$MODE" == "gui" ]]; then
        if zenity --question --title="Update Available" \
            --text="You are on version $VERSION. Version $latest_version is available.\n\nDo you want to update?" \
            --width=350 --height=120; then
            perform_update
        else
            zenity --warning --text="⚠️ You chose not to update.\nYou may not receive new questions." \
                --width=300 --height=100 --timeout=3
        fi
    else
        print_color "$YELLOW" "⚠️  Update Available!"
        print_color "$CYAN" "Current version: $VERSION"
        print_color "$CYAN" "Latest version: $latest_version"
        echo
        read -p "Do you want to update? (y/n): " choice
        if [[ "$choice" =~ ^[Yy]$ ]]; then
            perform_update
        else
            print_color "$YELLOW" "Continuing without update..."
            sleep 1
        fi
    fi
}

#=============================================================================
# Data Management
#=============================================================================

init_data() {
    [[ ! -d "$DATA_DIR" ]] && mkdir -p "$DATA_DIR"
    
    if [[ -f "$DATA_FILE" ]]; then
        source "$DATA_FILE"
        
        if [[ "$MODE" == "gui" ]]; then
            if zenity --question --title="Resume Game?" \
                --text="Previous game found!\n\nScore: $correct_answers/$current_question\n\nContinue?" \
                --width=300 --height=150; then
                zenity --info --text="📂 Resuming your quiz..." --width=300 --height=100 --timeout=2
            else
                reset_data
            fi
        else
            print_color "$YELLOW" "📂 Previous game found!"
            print_color "$CYAN" "Score: $correct_answers correct, $wrong_answers wrong"
            print_color "$CYAN" "Progress: $current_question/$TOTAL_QUESTIONS"
            echo
            read -p "Continue previous game? (y/n): " choice
            if [[ ! "$choice" =~ ^[Yy]$ ]]; then
                reset_data
            fi
        fi
    else
        reset_data
    fi
}

reset_data() {
    score=0
    current_question=0
    correct_answers=0
    wrong_answers=0
    > "$DATA_FILE"
}

save_progress() {
    cat > "$DATA_FILE" << EOF
score=$score
current_question=$current_question
correct_answers=$correct_answers
wrong_answers=$wrong_answers
EOF
}

#=============================================================================
# Question Functions
#=============================================================================

ask_question_gui() {
    local question="$1"
    local opt1="$2"
    local opt2="$3"
    local opt3="$4"
    local opt4="$5"
    local correct="$6"
    
    local answer
    answer=$(zenity --list --title="Question $((current_question + 1))/$TOTAL_QUESTIONS" \
        --text="$question" --radiolist \
        --column="Select" --column="Options" \
        FALSE "$opt1" \
        FALSE "$opt2" \
        FALSE "$opt3" \
        FALSE "$opt4" \
        --width=500 --height=350 2>/dev/null) || {
        if zenity --question --text="Exit quiz and save progress?" --width=300 --height=100; then
            save_progress
            zenity --info --text="💾 Progress saved!" --width=300 --height=100 --timeout=2
            exit 0
        else
            ask_question_gui "$question" "$opt1" "$opt2" "$opt3" "$opt4" "$correct"
            return
        fi
    }
    
    if [[ "$answer" == "$correct" ]]; then
        zenity --info --text="✅ Correct! Well done! 😃" --timeout=2 --width=250 --height=120
        ((correct_answers++))
    else
        zenity --error --text="❌ Wrong!\n\nCorrect answer: $correct" --timeout=3 --width=250 --height=120
        ((wrong_answers++))
    fi
    
    ((current_question++))
}

ask_question_cli() {
    local question="$1"
    local opt1="$2"
    local opt2="$3"
    local opt3="$4"
    local opt4="$5"
    local correct="$6"
    
    clear
    print_banner
    print_color "$BOLD" "Question $((current_question + 1))/$TOTAL_QUESTIONS"
    print_color "$CYAN" "Score: $correct_answers correct | $wrong_answers wrong"
    echo
    print_color "$YELLOW" "$question"
    echo
    echo "1) $opt1"
    echo "2) $opt2"
    echo "3) $opt3"
    echo "4) $opt4"
    echo
    
    local answer
    while true; do
        read -p "Your answer (1-4, or 'q' to quit): " answer
        
        if [[ "$answer" == "q" ]]; then
            save_progress
            print_color "$GREEN" "💾 Progress saved! Goodbye!"
            exit 0
        fi
        
        if [[ "$answer" =~ ^[1-4]$ ]]; then
            break
        else
            print_color "$RED" "Invalid input. Please enter 1-4 or 'q' to quit."
        fi
    done
    
    local selected_option
    case $answer in
        1) selected_option="$opt1" ;;
        2) selected_option="$opt2" ;;
        3) selected_option="$opt3" ;;
        4) selected_option="$opt4" ;;
    esac
    
    if [[ "$selected_option" == "$correct" ]]; then
        print_color "$GREEN" "\n✅ Correct! Well done! 😃"
        ((correct_answers++))
    else
        print_color "$RED" "\n❌ Wrong!"
        print_color "$YELLOW" "The correct answer was: $correct"
        ((wrong_answers++))
    fi
    
    ((current_question++))
    sleep 2
}

ask_question() {
    if [[ "$MODE" == "gui" ]]; then
        ask_question_gui "$@"
    else
        ask_question_cli "$@"
    fi
}

#=============================================================================
# Quiz Questions Database
#=============================================================================

run_quiz() {
    local questions=(
        "Which planet is known as the Red Planet?|Earth|Mars|Jupiter|Venus|Mars"
        "What is the capital of France?|Berlin|London|Madrid|Paris|Paris"
        "Who painted the Mona Lisa?|Van Gogh|Da Vinci|Picasso|Michelangelo|Da Vinci"
        "What is the largest ocean on Earth?|Atlantic|Indian|Arctic|Pacific|Pacific"
        "How many continents are there?|5|6|7|8|7"
        "What is the smallest country in the world?|Monaco|Vatican City|Malta|San Marino|Vatican City"
        "What is the chemical symbol for gold?|Go|Gd|Au|Ag|Au"
        "Who wrote 'Romeo and Juliet'?|Dickens|Shakespeare|Hemingway|Austen|Shakespeare"
        "What is the speed of light?|299,792 km/s|300,000 km/s|250,000 km/s|350,000 km/s|299,792 km/s"
        "Which gas do plants absorb?|Oxygen|Nitrogen|Carbon Dioxide|Hydrogen|Carbon Dioxide"
        "What is the capital of Japan?|Seoul|Beijing|Bangkok|Tokyo|Tokyo"
        "How many bones are in the human body?|198|206|215|220|206"
        "What is the largest mammal?|Elephant|Blue Whale|Giraffe|Polar Bear|Blue Whale"
        "Who invented the telephone?|Edison|Tesla|Bell|Marconi|Bell"
        "What is H2O commonly known as?|Hydrogen|Oxygen|Water|Peroxide|Water"
        "Which programming language is known for web development?|Python|JavaScript|C++|Rust|JavaScript"
        "What year did World War II end?|1943|1944|1945|1946|1945"
        "What is the largest desert?|Sahara|Arabian|Gobi|Antarctica|Antarctica"
        "Who developed the theory of relativity?|Newton|Einstein|Galileo|Hawking|Einstein"
        "What is the hardest natural substance?|Gold|Iron|Diamond|Platinum|Diamond"
        "How many hearts does an octopus have?|1|2|3|4|3"
        "What is the currency of Japan?|Yuan|Won|Yen|Ringgit|Yen"
        "Which planet has the most moons?|Jupiter|Saturn|Uranus|Neptune|Saturn"
        "What is the boiling point of water?|90°C|95°C|100°C|105°C|100°C"
        "Which river is the longest in the world?|Amazon|Nile|Yangtze|Mississippi|Nile"
    )
    
    for ((i=current_question; i<TOTAL_QUESTIONS; i++)); do
        IFS='|' read -r question opt1 opt2 opt3 opt4 correct <<< "${questions[$i]}"
        ask_question "$question" "$opt1" "$opt2" "$opt3" "$opt4" "$correct"
        save_progress
    done
}

#=============================================================================
# Results Display
#=============================================================================

show_results() {
    local percentage=$((correct_answers * 100 / TOTAL_QUESTIONS))
    
    if [[ "$MODE" == "gui" ]]; then
        local message="Quiz Complete!\n\n"
        message+="✅ Correct: $correct_answers\n"
        message+="❌ Wrong: $wrong_answers\n"
        message+="📊 Score: $percentage%\n\n"
        
        if [[ $correct_answers -eq $TOTAL_QUESTIONS ]]; then
            message+="🏆 Perfect Score! You're a trivia master!"
        elif [[ $correct_answers -ge 20 ]]; then
            message+="🌟 Excellent! Outstanding performance!"
        elif [[ $correct_answers -ge 15 ]]; then
            message+="👏 Great Job! You did well!"
        elif [[ $correct_answers -ge 10 ]]; then
            message+="😊 Good effort! Keep practicing!"
        else
            message+="📚 Keep learning! Practice makes perfect!"
        fi
        
        zenity --info --text="$message" --width=350 --height=250 --timeout=10
    else
        clear
        print_banner
        print_color "$BOLD" "🎊 QUIZ COMPLETE! 🎊"
        echo
        print_color "$GREEN" "✅ Correct Answers: $correct_answers"
        print_color "$RED" "❌ Wrong Answers: $wrong_answers"
        print_color "$CYAN" "📊 Total Questions: $TOTAL_QUESTIONS"
        print_color "$YELLOW" "🎯 Score: $percentage%"
        echo
        
        if [[ $correct_answers -eq $TOTAL_QUESTIONS ]]; then
            print_color "$GREEN" "🏆 Perfect Score! You're a trivia master!"
        elif [[ $correct_answers -ge 20 ]]; then
            print_color "$GREEN" "🌟 Excellent! Outstanding performance!"
        elif [[ $correct_answers -ge 15 ]]; then
            print_color "$CYAN" "👏 Great Job! You did well!"
        elif [[ $correct_answers -ge 10 ]]; then
            print_color "$YELLOW" "😊 Good effort! Keep practicing!"
        else
            print_color "$YELLOW" "📚 Keep learning! Practice makes perfect!"
        fi
        echo
        read -p "Press Enter to exit..."
    fi
    
    reset_data
}

#=============================================================================
# Main Function
#=============================================================================

show_welcome() {
    if [[ "$MODE" == "gui" ]]; then
        zenity --info --text="🎉 Welcome to Trivia Quiz Game!\n\nVersion: $VERSION\nMode: GUI" \
            --width=300 --height=150 --timeout=3
        zenity --info --text="💾 Progress auto-saves after each question.\n\nPress Cancel to exit anytime." \
            --width=350 --height=120
    else
        print_banner
        print_color "$GREEN" "Mode: CLI"
        print_color "$CYAN" "💾 Progress auto-saves after each question."
        print_color "$CYAN" "Press 'q' during questions to exit safely."
        echo
        read -p "Press Enter to start..."
    fi
}

main() {
    detect_mode "$@"
    install_zenity
    
    if check_updates; then
        prompt_update
    fi
    
    init_data
    show_welcome
    run_quiz
    show_results
}

# Run the script
main "$@"
